# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Rate Limiter (Upstash Redis)
REDIS_URL=rediss://default:your_upstash_password@your-redis-instance.upstash.io:6379

# GitHub Telemetry
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Transactional Email Dispatch (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
# Must be an address on a Resend-VERIFIED domain. Resend rejects unverified
# senders, and a rejected send means a paying subscriber receives no key.
RESEND_FROM_EMAIL=keys@your-verified-domain.com

# Merchant of Record (Lemon Squeezy)
LEMON_SQUEEZY_WEBHOOK_SECRET=your_lemon_squeezy_webhook_signing_secret
LEMON_SQUEEZY_VARIANT_ID=your_lemon_squeezy_variant_id_here

# API key derivation. Generate once with: openssl rand -hex 32
# Raw keys are derived deterministically from this secret plus the subscription id,
# so a retried webhook regenerates the identical key. Rotating this secret means
# previously issued keys can no longer be re-derived (they keep working — only
# their hashes are stored — but a retry would issue a different key).
API_KEY_SIGNING_SECRET=your_32_byte_hex_signing_secret

# On-demand cache validity, in hours. Records older than this are served from
# cache while a background refresh is dispatched.
CACHE_TTL_HOURS=6

# GraphQL budget the scheduled scraper leaves untouched, reserved for
# customer-facing on-demand fetches.
GITHUB_RATELIMIT_RESERVE=1000
